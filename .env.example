# Copy this to .env for local development, and set the same values
# as environment variables in your Render service settings.

# Connection string from your Neon project dashboard (Neon calls this the
# "connection string" — looks like postgres://user:pass@host/dbname?sslmode=require)
DATABASE_URL=

# Port the Express server listens on. Render sets this automatically in
# production, so you usually only need this for local dev.
PORT=3001
