    "favorite": true,
    "tags": [
      "Bright",
      "Smooth",
      "Citrus",
      "Aromatic"
    ],
    "ingredients": [
      {
        "id": "ouzo",
        "amount": "2oz"
      },
      {
        "id": "limoncello",
        "amount": "2oz"
      },
      {
        "id": "lemon-juice",
        "amount": "1oz"
      },
      {
        "id": "simple-syrup",
        "amount": "0.5oz"
      },
      {
        "id": "egg-white",
        "amount": "1"
      }
    ],
    "instructions": [
      "Add ouzo, limoncello, lemon juice, simple syrup, and egg white to a shaker",
      "Dry shake vigorously (no ice) for 15–20 seconds to emulsify the egg white",
      "Add ice and shake again until well chilled",
      "Double strain into a glass",
      "Garnish with an orange twist."
    ]
